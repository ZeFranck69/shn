<header class="tf-site-header" data-tf-site-header>
    <div class="tf-site-header__inner">
        <a class="tf-site-header__brand" href="{{ language_home_url|e('html_attr') }}#accueil" aria-label="{{ function('tealforge_i18n', 'Le Domaine du Pacifique, retour en haut de page', 'Le Domaine du Pacifique, back to top') }}">
            {% if options.logo_header_light or options.logo_header_dark %}
                {% if options.logo_header_light %}
                    <img
                        class="tf-site-header__logo tf-site-header__logo--light{% if not options.logo_header_dark %} tf-site-header__logo--fallback{% endif %}"
                        src="{{ options.logo_header_light.url|e('html_attr') }}"
                        alt="{{ options.logo_header_light.alt ?: 'Le Domaine du Pacifique' }}"
                    >
                {% endif %}

                {% if options.logo_header_dark %}
                    <img
                        class="tf-site-header__logo tf-site-header__logo--dark{% if not options.logo_header_light %} tf-site-header__logo--fallback{% endif %}"
                        src="{{ options.logo_header_dark.url|e('html_attr') }}"
                        alt="{{ options.logo_header_dark.alt ?: 'Le Domaine du Pacifique' }}"
                    >
                {% endif %}
            {% else %}
                <span>Le Domaine</span>
                <small>du Pacifique</small>
            {% endif %}
        </a>

        <nav class="tf-site-header__nav" aria-label="Navigation principale" data-tf-menu-panel>
            {% if menus.primary and menus.primary.items %}
                {% for item in menus.primary.items %}
                    <a
                        href="{{ item.link|e('html_attr') }}"
                        {% if item.target and item.target != '_self' %}target="{{ item.target|e('html_attr') }}"{% if item.target == '_blank' %} rel="noopener"{% endif %}{% endif %}
                    >
                        {{ item.title }}
                    </a>
                {% endfor %}
            {% else %}
                <a href="{{ language_home_url|e('html_attr') }}#groupe">{{ function('tealforge_i18n', 'Le groupe', 'The group') }}</a>
                <a href="{{ language_home_url|e('html_attr') }}#hebergements">{{ function('tealforge_i18n', 'Hébergements', 'Accommodation') }}</a>
                <a href="{{ language_home_url|e('html_attr') }}#experiences">{{ function('tealforge_i18n', 'Expériences', 'Experiences') }}</a>
                <a href="{{ language_home_url|e('html_attr') }}#contact">{{ function('tealforge_i18n', 'Contact', 'Contact') }}</a>
            {% endif %}
        </nav>

        <div class="tf-site-header__right">
            {% if language_switcher %}
                <div class="tf-site-header__lang" aria-label="{{ function('tealforge_i18n', 'Choix de la langue', 'Language selector') }}">
                    {% for language in language_switcher %}
                        {% if not loop.first %}
                            <span>/</span>
                        {% endif %}
                        <a href="{{ language.url|e('html_attr') }}" {% if language.current_lang %}aria-current="true"{% endif %}>
                            {{ language.slug|upper }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

            <button
                class="tf-site-header__toggle"
                type="button"
                aria-label="{{ function('tealforge_i18n', 'Ouvrir le menu', 'Open menu') }}"
                aria-expanded="false"
                data-tf-menu-toggle
                data-tf-menu-open-label="{{ function('tealforge_i18n', 'Ouvrir le menu', 'Open menu') }}"
                data-tf-menu-close-label="{{ function('tealforge_i18n', 'Fermer le menu', 'Close menu') }}"
            >
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </div>
</header>

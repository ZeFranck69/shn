<section class="tf-section tf-section--ocean tf-destinations" id="{{ section.anchor_id|e('html_attr') }}">
    <div class="tf-container">
        <div class="reveal">
            <p class="tf-eyebrow">{{ section.eyebrow }}</p>
            <h2 class="tf-h2">{{ section.title|raw }}</h2>
            <p class="tf-section__intro">{{ section.intro|raw }}</p>
        </div>

        <div class="tf-destinations__grid">
            {% for destination in section.items %}
                <article class="tf-destinations__item reveal">
                    <span>{{ destination.index }}</span>
                    <h3>{{ destination.title }}</h3>
                    <p>{{ destination.place }}</p>

                    {% if destination.links %}
                        <ul>
                            {% for link in destination.links %}
                                <li class="{% if link.type == 'expérience' %}is-expérience{% endif %}">{{ link.label }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    </div>
</section>

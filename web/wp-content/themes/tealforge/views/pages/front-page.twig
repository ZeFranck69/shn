{% extends 'layouts/base.twig' %}

{% block content %}
    {% for section in sections %}
        {% include 'sections/' ~ section.layout ~ '.twig' with { section: section, options: options } only %}
    {% else %}
        <section class="tf-content">
            <div class="tf-content__inner">
                <p>Aucune section n'est encore configuree.</p>
            </div>
        </section>
    {% endfor %}
{% endblock %}

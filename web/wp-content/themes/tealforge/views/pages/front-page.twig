{% extends 'layouts/base.twig' %}

{% block content %}
    {% for section in sections %}
        {% if section.layout != 'quote' %}
            {% include 'sections/' ~ section.layout ~ '.twig' with { section: section, options: options } only %}
        {% endif %}
    {% else %}
        <section class="tf-content">
            <div class="tf-content__inner">
                <p>{{ function('tealforge_i18n', 'Aucune section n’est encore configurée.', 'No section has been configured yet.') }}</p>
            </div>
        </section>
    {% endfor %}
{% endblock %}

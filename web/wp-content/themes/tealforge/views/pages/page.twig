{% extends 'layouts/base.twig' %}

{% block content %}
    {% if sections is defined and sections %}
        {% for section in sections %}
            {% if section.layout != 'quote' %}
                {% include 'sections/' ~ section.layout ~ '.twig' with { section: section, options: options } only %}
            {% endif %}
        {% endfor %}
    {% else %}
        <article class="tf-content">
            <div class="tf-content__inner">
                <h1>{{ post.title }}</h1>

                {% if post.content %}
                    <div class="tf-wysiwyg">
                        {{ post.content }}
                    </div>
                {% endif %}
            </div>
        </article>
    {% endif %}
{% endblock %}
